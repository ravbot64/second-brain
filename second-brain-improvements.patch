diff --git a/.github/workflows/keep-alive.yml b/.github/workflows/keep-alive.yml
new file mode 100644
index 0000000..dedc4ae
--- /dev/null
+++ b/.github/workflows/keep-alive.yml
@@ -0,0 +1,49 @@
+name: Keep backend awake
+
+# Render's free tier spins the backend down after ~15 minutes of inactivity,
+# which causes a slow (~50s) cold start on the next request. This workflow pings
+# the health endpoint every 10 minutes to keep it warm.
+#
+# Setup: add a repository variable named BACKEND_URL pointing at the deployed API
+# root, e.g. https://your-service.onrender.com
+# (Settings -> Secrets and variables -> Actions -> Variables -> New variable)
+
+on:
+  schedule:
+    - cron: "*/10 * * * *"
+  workflow_dispatch: {}
+
+permissions:
+  contents: read
+
+concurrency:
+  group: keep-alive
+  cancel-in-progress: true
+
+jobs:
+  ping:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - name: Ping health endpoint
+        env:
+          BACKEND_URL: ${{ vars.BACKEND_URL }}
+        run: |
+          if [ -z "${BACKEND_URL}" ]; then
+            echo "BACKEND_URL repository variable is not set; skipping."
+            exit 0
+          fi
+          url="${BACKEND_URL%/}/"
+          echo "Pinging ${url}"
+          # Retry a few times to cover the cold-start window.
+          for attempt in 1 2 3 4 5 6; do
+            code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 60 "${url}" || echo 000)"
+            echo "Attempt ${attempt}: HTTP ${code}"
+            if [ "${code}" = "200" ]; then
+              echo "Backend is awake."
+              exit 0
+            fi
+            sleep 15
+          done
+          echo "Backend did not return 200 in time." >&2
+          exit 1
